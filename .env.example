# Copy to .env (git-ignored). The Supabase CLI substitutes env(...) in supabase/config.toml
# from here when the stack starts, so these must be set BEFORE `npm run db`.
# Distinct from supabase/functions/.env, which holds runtime secrets for the functions themselves.
#
# Each provider console needs the callback URL:
#   local  http://127.0.0.1:54321/auth/v1/callback
#   hosted https://<project-ref>.supabase.co/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_FACEBOOK_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_FACEBOOK_SECRET=
