# Copy to supabase/functions/.env (git-ignored). Loaded by `supabase start` and by
# `supabase functions serve`; pushed to production with `supabase secrets set --env-file`.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# OPENAI_LIVE_TRANSCRIBE_MODEL=gpt-live-transcribe
TYPESAFE_API_KEY=
# Signs the live-dictation socket's tickets (POST /voice-session -> the `voice` function). Any long
# random string, e.g. `openssl rand -hex 32`. Required on the edge; the local Node server makes one up.
VOICE_TICKET_SECRET=
# Lock CORS to the published extension once you know its id.
# ALLOWED_ORIGINS=chrome-extension://<id>
# No DATABASE_URL: Supabase injects SUPABASE_DB_URL locally and in a deployed function.
# Set it only to point the function at some other database.
# Dev word counter behind GET /stats (local Node server only; the edge has no writable disk). Default: api/word-stats.json.
# WORD_STATS_FILE=
