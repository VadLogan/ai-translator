# Copy to supabase/functions/.env (git-ignored). Loaded by `supabase start` and by
# `supabase functions serve`; pushed to production with `supabase secrets set --env-file`.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
# Lock CORS to the published extension once you know its id.
# ALLOWED_ORIGINS=chrome-extension://<id>
# No DATABASE_URL: Supabase injects SUPABASE_DB_URL locally and in a deployed function.
# Set it only to point the function at some other database.
