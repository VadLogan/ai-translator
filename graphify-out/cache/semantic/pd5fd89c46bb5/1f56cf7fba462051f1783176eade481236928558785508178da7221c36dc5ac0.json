{"nodes": [{"id": "_claude_rules_api_architecture", "label": "API architecture rules", "file_type": "document", "source_file": ".claude/rules/api-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_rules_api_architecture_entrypoint_layer", "label": "Entrypoint layer (index.ts, server.ts, health.ts)", "file_type": "rationale", "source_file": ".claude/rules/api-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only place that knows which runtime it is on."}, {"id": "_claude_rules_api_architecture_wiring_layer", "label": "Wiring layer (app.ts)", "file_type": "rationale", "source_file": ".claude/rules/api-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owns CORS, the route table and notFound; never branches on runtime or does work."}, {"id": "_claude_rules_api_architecture_middleware_layer", "label": "Middleware layer (requireUser, rateLimit, validate)", "file_type": "rationale", "source_file": ".claude/rules/api-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guards produce 401/429/400 and must not touch the DB or a provider."}, {"id": "_claude_rules_api_architecture_controller_layer", "label": "Controller layer", "file_type": "rationale", "source_file": ".claude/rules/api-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owns the whole per-route body and its own response; only controllers call repositories."}, {"id": "_claude_rules_api_architecture_service_layer", "label": "Service layer (translate.ts, detect.ts)", "file_type": "rationale", "source_file": ".claude/rules/api-architecture.md", "source_location": null, "source_url": null, "captured_