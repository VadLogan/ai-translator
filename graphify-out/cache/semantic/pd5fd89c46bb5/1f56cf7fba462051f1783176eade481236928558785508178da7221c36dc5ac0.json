ile": ".claude/rules/api-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "waitUntil plus .catch logging stay in the controller so the log line carries the controller request id."}, {"id": "_claude_rules_api_architecture_route_is_a_sentence", "label": "A route is a sentence in app.ts", "file_type": "rationale", "source_file": ".claude/rules/api-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guards first; rateLimit after requireUser because it counts per user id, and only on provider routes."}, {"id": "_claude_rules_api_architecture_validation_once", "label": "Validation happens once at the boundary", "file_type": "rationale", "source_file": ".claude/rules/api-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Controllers read c.get(body) and trust it; nothing re-validates downstream."}, {"id": "_claude_rules_api_architecture_controller_owns_response", "label": "A controller owns its own response", "file_type": "rationale", "source_file": ".claude/rules/api-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Helpers return data; repetition across provider routes is deliberate so the route reads in one file."}, {"id": "_claude_rules_api_architecture_userid_decode_not_verify", "label": "userIdFrom() decodes but does not verify JWT", "file_type": "rationale", "source_file": ".claude/rules/api-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gateway verify_jwt=true already checked the signature; disabling it without verification makes sub forgeable."}, {"id": "_claude_rules_api_architecture_erasable_ts", "label": "Erasable TypeScript constraint", "file_