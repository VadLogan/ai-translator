{"nodes": [{"id": "claude", "label": "CLAUDE.md", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_frontend_only_extension", "label": "Extension is frontend only", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Translation and provider selection live in the API because a provider key shipped in the extension is public."}, {"id": "claude_settings_cache", "label": "Settings cache (server-authoritative)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Settings live on profiles.settings to follow the user across devices; chrome.storage is a fast offline cache. API first, cache second; last write wins."}, {"id": "claude_layered_api_architecture", "label": "Layered API architecture", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "entrypoint -> wiring -> middleware -> controller -> service -> repository -> db; each layer calls only the one below."}, {"id": "claude_three_entrypoints_one_app", "label": "Three entrypoints, one app", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only index.ts, health.ts and server.ts know the runtime; app.ts never branches on runtime."}, {"id": "claude_dev_gateway_emulation", "label": "dev-gateway Supabase gateway emulation", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Emulates /functions/v1 prefixes, gateway 401 bodies and signature check (ES256/RS256 via JWKS, HS256 dev tokens); can drift, so dev:api:edge before deploy."}, {"id": "claude_verify_jwt_gate", "label": "verify_jwt gateway gate", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "verify_jwt is per-function and enforced before the handler, so health is a separate function; userIdFrom decodes without verifying because the gateway already did."}, {"id": "claude_gateway_401_status_detection", "label": "Unauthenticated derived from 401 status", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gateway 401 bodies are {code,message}, not {error:{...}}, so the extension reads the status to show the sign-in prompt."}, {"id": "claude_waituntil_save", "label": "waitUntil DB save", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps the isolate alive until the insert lands; saving never fails the request."}, {"id": "claude_trace_id", "label": "trace_id generated sha256 column", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fingerprints selected text so all attempts (translations, detections, corrections, rewrites) join without foreign keys."}, {"id": "claude_detection_verified", "label": "detections.verified feedback", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Written by POST /translate: null = closed, true = detected lang used, false = user overrode. Matched by hashing text in SQL with ::text::bytea."}, {"id": "claude_mistyped_layout_switch", "label": "Wrong keyboard layout (mistyped + switchLayout)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client re-types locally with a key-position map: free and can't hallucinate."}, {"id": "claude_fix_grammar_route", "label": "POST /fix-grammar", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_rewrite_route", "label": "POST /rewrite", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_profiles_table", "label": "profiles table", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "auth.users belongs to GoTrue; app columns go on profiles, populated by on_auth_user_created trigger; settings merged over DEFAULT_SETTINGS so no data migration."}, {"id": "claude_hand_rolled_pkce", "label": "Hand-rolled PKCE OAuth", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "chrome.identity.launchWebAuthFlow + two fetches keeps zero runtime deps; refresh on demand since MV3 workers die between requests."}, {"id": "claude_background_worker_messaging", "label": "Typed background-worker messaging protocol", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "API calls stay in the worker: host_permissions exempt CORS and avoid mixed content; sender url read from onMessage sender to prevent forgery."}, {"id": "claude_paste_first_replacement", "label": "Paste-fi