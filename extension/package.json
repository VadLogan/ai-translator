{
  "name": "ai-translator-ext",
  "description": "Translate selected text in any input field on the fly",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:playground": "python3 -m http.server 5555 --bind 127.0.0.1 -d playground & wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "deploy": "npm run compile && npm test && wxt zip && wxt submit --chrome-zip output/$npm_package_name-$npm_package_version-chrome.zip",
    "deploy:check": "wxt zip && wxt submit --dry-run --chrome-zip output/$npm_package_name-$npm_package_version-chrome.zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^20.14.5",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
