{
  "name": "ai-translator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["api", "extension"],
  "scripts": {
    "dev": "npm run dev:api & npm run dev:extension",
    "dev:api": "npm run dev -w api",
    "dev:extension": "npm run dev:playground -w extension",
    "build": "npm run build --workspaces --if-present",
    "compile": "npm run compile --workspaces --if-present",
    "test": "npm test --workspaces --if-present"
  }
}
